{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/design-ontology-harness/preset-matrix.schema.json",
  "title": "Preset Matrix",
  "description": "Design Ontology plugin preset catalog — axes and preset index. ID rule: {app_mode}--{brand_tone}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_version",
    "app_modes",
    "brand_tones",
    "color_modes",
    "presets"
  ],
  "properties": {
    "matrix_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of this matrix file format."
    },
    "app_modes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "representative_ux"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "dashboard",
              "document-content",
              "marketing-landing",
              "commerce",
              "conversation-copilot",
              "canvas-tool",
              "community-feed",
              "monitoring-ops"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "representative_ux": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "brand_tones": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "keywords", "palette_bias"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "minimal-tech",
              "editorial-warm",
              "bold-confident",
              "playful-soft",
              "corporate-trust"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "palette_bias": { "type": "string", "minLength": 1 }
        }
      }
    },
    "color_modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["light", "dark", "both"]
      }
    },
    "presets": {
      "type": "array",
      "items": { "$ref": "#/$defs/preset_entry" }
    }
  },
  "$defs": {
    "preset_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app_mode",
        "brand_tone",
        "color_modes",
        "default_color_mode",
        "tags",
        "description",
        "source_project",
        "owner",
        "preview_path",
        "locale_pairings",
        "tier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(dashboard|document-content|marketing-landing|commerce|conversation-copilot|canvas-tool|community-feed|monitoring-ops)--(minimal-tech|editorial-warm|bold-confident|playful-soft|corporate-trust)$",
          "description": "Must equal {app_mode}--{brand_tone}."
        },
        "app_mode": {
          "type": "string",
          "enum": [
            "dashboard",
            "document-content",
            "marketing-landing",
            "commerce",
            "conversation-copilot",
            "canvas-tool",
            "community-feed",
            "monitoring-ops"
          ]
        },
        "brand_tone": {
          "type": "string",
          "enum": [
            "minimal-tech",
            "editorial-warm",
            "bold-confident",
            "playful-soft",
            "corporate-trust"
          ]
        },
        "color_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["light", "dark"] }
        },
        "default_color_mode": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "source_project": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "preview_path": {
          "type": "string",
          "pattern": "^presets/[a-z0-9-]+(--[a-z0-9-]+)?/preview\\.md$"
        },
        "locale_pairings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading_font", "body_font"],
            "properties": {
              "heading_font": { "type": "string", "minLength": 1 },
              "body_font": { "type": "string", "minLength": 1 },
              "font_asset_path": { "type": "string" }
            }
          }
        },
        "tier": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "deprecated_at": { "type": "string", "format": "date" },
        "deprecation_reason": { "type": "string" }
      },
      "allOf": [
        {
          "description": "default_color_mode must be present in color_modes.",
          "if": { "properties": { "default_color_mode": { "const": "light" } } },
          "then": { "properties": { "color_modes": { "contains": { "const": "light" } } } }
        },
        {
          "if": { "properties": { "default_color_mode": { "const": "dark" } } },
          "then": { "properties": { "color_modes": { "contains": { "const": "dark" } } } }
        }
      ]
    }
  }
}
