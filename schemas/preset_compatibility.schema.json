{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/design-ontology-harness/preset-compatibility.schema.json",
  "title": "Preset Compatibility Matrix",
  "description": "Maps preset_api_version to supported adapter semver ranges. Single source of truth for sync-time validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_preset_api_version", "supported_preset_api_range", "entries"],
  "properties": {
    "current_preset_api_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "The preset_api_version the harness currently emits."
    },
    "supported_preset_api_range": {
      "type": "string",
      "minLength": 1,
      "description": "Semver range (e.g. >=1.0.0 <2.0.0) the plugin must support."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset_api_version", "adapter_ranges"],
        "properties": {
          "preset_api_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "deprecated": { "type": "boolean", "default": false },
          "notes": { "type": "string" },
          "adapter_ranges": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
