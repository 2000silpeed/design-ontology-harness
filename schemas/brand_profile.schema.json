{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/design-ontology-harness/brand-profile.schema.json",
  "title": "Brand Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "brand_name",
    "system_name",
    "product_summary",
    "audiences",
    "brand_keywords",
    "anti_keywords",
    "tone_of_voice",
    "visual_keywords",
    "interaction_keywords",
    "platforms",
    "accessibility_targets",
    "product_primitives"
  ],
  "properties": {
    "brand_name": { "type": "string", "minLength": 1 },
    "system_name": { "type": "string", "minLength": 1 },
    "product_summary": { "type": "string", "minLength": 1 },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "brand_keywords": { "type": "array", "items": { "type": "string" } },
    "anti_keywords": { "type": "array", "items": { "type": "string" } },
    "tone_of_voice": { "type": "array", "items": { "type": "string" } },
    "visual_keywords": { "type": "array", "items": { "type": "string" } },
    "interaction_keywords": { "type": "array", "items": { "type": "string" } },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "accessibility_targets": { "type": "array", "items": { "type": "string" } },
    "product_primitives": { "type": "array", "items": { "type": "string" } },
    "component_decision_path": {
      "type": "string",
      "pattern": "^[^/].*\\.json$",
      "description": "Project-relative JSON file containing an authored component_decision contract."
    },
    "component_decision": {
      "type": "object",
      "required": [
        "core_components",
        "primitive_reconciliation_version",
        "primitive_reconciliation"
      ],
      "properties": {
        "mode": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 },
        "coverage_families": { "type": "array", "items": { "type": "string" } },
        "primitive_reconciliation_version": {
          "const": "product-primitive-reconciliation/v1"
        },
        "primitive_reconciliation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["primitive", "resolution", "reason"],
            "properties": {
              "primitive": { "type": "string", "minLength": 1 },
              "resolution": { "enum": ["component", "anatomy", "waiver"] },
              "component": { "type": "string", "minLength": 1 },
              "anatomy_parts": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "reason": { "type": "string", "minLength": 1 },
              "waiver": {
                "type": "object",
                "required": [
                  "kind",
                  "replacement_components",
                  "decision_source",
                  "approval_status"
                ],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "replacement_components": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "decision_source": { "type": "string", "minLength": 1 },
                  "approval_status": { "const": "approved" }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "resolution": { "const": "component" } } },
                "then": { "required": ["component"] }
              },
              {
                "if": { "properties": { "resolution": { "const": "anatomy" } } },
                "then": { "required": ["component", "anatomy_parts"] }
              },
              {
                "if": { "properties": { "resolution": { "const": "waiver" } } },
                "then": { "required": ["waiver"] }
              }
            ]
          }
        },
        "core_components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentContractInput" }
        },
        "rejected_components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "family": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reference_preferences": {
      "type": "object",
      "properties": {
        "prioritize_sources_containing": { "type": "array", "items": { "type": "string" } },
        "avoid_sources_containing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "color_reference": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "preferred_families": { "type": "array", "items": { "type": "string" } },
        "selected_colors": { "type": "array", "items": { "type": "string" } },
        "palette_roles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "palette_strategy": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["manual", "brand-guided", "exploratory"] },
            "candidate_count": { "type": "integer", "minimum": 1, "maximum": 5 },
            "active_candidate": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string" }
              ]
            },
            "temperature": { "type": "string", "enum": ["warm", "neutral", "mixed"] },
            "contrast": { "type": "string", "enum": ["soft", "balanced", "vivid"] },
            "diversity": { "type": "string", "enum": ["cohesive", "balanced", "exploratory"] },
            "surface_style": { "type": "string", "enum": ["airy", "tinted", "grounded"] },
            "prefer_moods": { "type": "array", "items": { "type": "string" } },
            "avoid_moods": { "type": "array", "items": { "type": "string" } }
          }
        },
        "palette_expansion": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "supporting_color_count": { "type": "integer", "minimum": 4, "maximum": 24 },
            "combination_count": { "type": "integer", "minimum": 2, "maximum": 6 },
            "prefer_pairings": { "type": "boolean" },
            "prefer_related_families": { "type": "boolean" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual_reference": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local-images", "pinterest-assisted"]
        },
        "query": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sources": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string" },
                  "path": { "type": "string" },
                  "url": { "type": "string" },
                  "label": { "type": "string" },
                  "tags": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            ]
          }
        },
        "preferred_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "weights": {
          "type": "object",
          "properties": {
            "layout": { "type": "number", "minimum": 0 },
            "component_shape": { "type": "number", "minimum": 0 },
            "color_balance": { "type": "number", "minimum": 0 },
            "typography_mood": { "type": "number", "minimum": 0 },
            "surface_style": { "type": "number", "minimum": 0 }
          }
        },
        "extraction_policy": {
          "type": "string",
          "enum": ["advisory-only", "allow-token-suggestions"]
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "must_include": { "type": "array", "items": { "type": "string" } },
        "avoid_patterns": { "type": "array", "items": { "type": "string" } },
        "pinterest_assist": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "capture_mode": {
              "type": "string",
              "enum": ["manual-save", "playwright-capture"]
            },
            "capture_dir": { "type": "string" },
            "max_candidates_per_query": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_selected_per_query": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "preferred_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["pins", "boards", "adjacent-search"]
              }
            },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "componentContractInput": {
      "type": "object",
      "required": [
        "name", "family", "role", "supports_primitive", "decision_reason",
        "anatomy", "states", "variants", "props", "interaction",
        "data_contract", "responsive", "content_rules", "accessibility_notes",
        "dos_and_donts", "tokens"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "family": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "supports_primitive": { "type": "string", "minLength": 1 },
        "decision_reason": { "type": "string", "minLength": 1 },
        "anatomy": {
          "oneOf": [
            { "type": "array", "minItems": 2, "items": { "type": "string" } },
            {
              "type": "object",
              "required": ["parts"],
              "properties": {
                "parts": { "type": "array", "minItems": 2, "items": { "type": "string" } }
              }
            }
          ]
        },
        "states": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "variants": { "type": "object", "minProperties": 1 },
        "props": { "type": "object", "minProperties": 1 },
        "interaction": { "type": "object", "minProperties": 1 },
        "data_contract": { "type": "object", "minProperties": 1 },
        "responsive": { "type": "object", "minProperties": 1 },
        "content_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "accessibility_notes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dos_and_donts": {
          "type": "object",
          "required": ["do", "dont"],
          "properties": {
            "do": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "dont": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "tokens": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "pattern": "^(component|part|state)\\.[a-z0-9-]+\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "var\\(\\s*--ds-[a-zA-Z0-9-]+"
          }
        }
      }
    }
  }
}
