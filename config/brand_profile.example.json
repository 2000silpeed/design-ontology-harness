{
  "brand_name": "Signal Desk",
  "system_name": "Signal System",
  "product_summary": "작은 팀과 개인 제작자를 위한 고집 있는 에디토리얼 업무 앱",
  "audiences": [
    "독립 창작자",
    "콘텐츠 팀",
    "브랜드 운영자"
  ],
  "brand_keywords": [
    "calm",
    "precise",
    "editorial",
    "trustworthy"
  ],
  "anti_keywords": [
    "generic",
    "noisy",
    "overdecorated",
    "playful"
  ],
  "tone_of_voice": [
    "clear",
    "warm",
    "confident"
  ],
  "visual_keywords": [
    "structured whitespace",
    "measured contrast",
    "text-first hierarchy"
  ],
  "interaction_keywords": [
    "predictable states",
    "low-noise motion",
    "deliberate emphasis"
  ],
  "platforms": [
    "web",
    "ios"
  ],
  "accessibility_targets": [
    "WCAG 2.2 AA"
  ],
  "product_primitives": [
    "workspace navigation",
    "rich text editor",
    "command palette",
    "dashboard cards",
    "data tables"
  ],
  "reference_preferences": {
    "prioritize_sources_containing": [
      "typography",
      "accessibility",
      "components",
      "design token"
    ],
    "avoid_sources_containing": [
      "brand-only"
    ]
  },
  "color_reference": {
    "path": "docs/color-reference.md",
    "preferred_families": [
      "Deep Reds",
      "Standard Oranges",
      "Pastel Oranges"
    ],
    "palette_strategy": {
      "mode": "brand-guided",
      "candidate_count": 3,
      "active_candidate": 1,
      "temperature": "warm",
      "contrast": "balanced",
      "diversity": "balanced",
      "surface_style": "tinted",
      "prefer_moods": [
        "세련됨",
        "신뢰감"
      ],
      "avoid_moods": [
        "달콤함",
        "귀여움"
      ]
    },
    "palette_expansion": {
      "enabled": true,
      "supporting_color_count": 12,
      "combination_count": 4,
      "prefer_pairings": true,
      "prefer_related_families": true
    },
    "notes": [
      "색상 레퍼런스는 semantic token 설계의 출발점으로 사용",
      "raw reference color를 그대로 전체 UI에 덮지 않기",
      "selected_colors와 palette_roles를 넣으면 manual override로 동작",
      "palette_expansion은 seed color를 기반으로 support, neutral, semantic state 후보를 확장합니다"
    ]
  },
  "visual_reference": {
    "mode": "pinterest-assisted",
    "query": [
      "editorial dashboard",
      "warm productivity workspace",
      "premium content operations UI"
    ],
    "sources": [
      {
        "kind": "image",
        "path": "references/visual/editorial-dashboard-01.png",
        "label": "Editorial dashboard moodboard",
        "tags": [
          "dashboard",
          "editorial",
          "warm"
        ]
      },
      {
        "kind": "directory",
        "path": "references/visual/collection",
        "label": "Curated visual references",
        "tags": [
          "cards",
          "surface-style"
        ]
      }
    ],
    "preferred_count": 12,
    "weights": {
      "layout": 0.3,
      "component_shape": 0.25,
      "color_balance": 0.2,
      "typography_mood": 0.15,
      "surface_style": 0.1
    },
    "extraction_policy": "advisory-only",
    "must_include": [
      "split-pane workspace",
      "low-elevation cards"
    ],
    "avoid_patterns": [
      "high-saturation neon UI",
      "glassmorphism-heavy surfaces"
    ],
    "notes": [
      "현재 단계에서는 로컬 이미지/스크린샷만 직접 분석합니다",
      "Pinterest는 query 생성과 수집 보조 채널로만 사용하고, 최종 입력은 로컬 파일로 고정합니다"
    ],
    "pinterest_assist": {
      "enabled": true,
      "capture_mode": "manual-save",
      "capture_dir": "references/visual/pinterest-assisted",
      "max_candidates_per_query": 6,
      "max_selected_per_query": 2,
      "preferred_sources": [
        "pins",
        "boards",
        "adjacent-search"
      ],
      "notes": [
        "generate-visual-queries 는 build/visuals 아래에 plan / candidate / selection manifest를 생성합니다",
        "사용자나 에이전트가 명시적으로 selected 로 승격한 캡처만 visual_reference.sources 로 연결합니다"
      ]
    }
  }
}
